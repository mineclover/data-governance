{
  "name": "@oa-sdk/dpm",
  "version": "0.1.3",
  "description": "Relationship-first Data Pseudonymization Manifest toolkit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mineclover/data-governance.git",
    "directory": "packages/dpm"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "oa-dpm": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package": {
      "import": "./dist/public/package.js",
      "types": "./dist/public/package.d.ts"
    },
    "./catalog": {
      "import": "./dist/public/catalog.js",
      "types": "./dist/public/catalog.d.ts"
    },
    "./data": {
      "import": "./dist/public/data.js",
      "types": "./dist/public/data.d.ts"
    },
    "./profile": {
      "import": "./dist/public/profile.js",
      "types": "./dist/public/profile.d.ts"
    },
    "./relationship": {
      "import": "./dist/public/relationship.js",
      "types": "./dist/public/relationship.d.ts"
    },
    "./gateway": {
      "import": "./dist/public/gateway.js",
      "types": "./dist/public/gateway.d.ts"
    },
    "./storage": {
      "import": "./dist/public/storage.js",
      "types": "./dist/public/storage.d.ts"
    },
    "./publishing": {
      "import": "./dist/public/publishing.js",
      "types": "./dist/public/publishing.d.ts"
    },
    "./authoring": {
      "import": "./dist/public/authoring.js",
      "types": "./dist/public/authoring.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts src/cli/index.ts src/public/package.ts src/public/catalog.ts src/public/data.ts src/public/profile.ts src/public/relationship.ts src/public/gateway.ts src/public/storage.ts src/public/publishing.ts src/public/authoring.ts --format esm --dts",
    "smoke:pack": "mkdir -p dist && echo stale > dist/stale-pack-boundary.txt && corepack pnpm build && node test/package-pack-smoke.mjs",
    "smoke:subpaths": "corepack pnpm build && node test/package-subpath-import-smoke.mjs && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --types node test/package-subpath-type-consumer.ts",
    "smoke:cli": "corepack pnpm build && node test/package-cli-smoke.mjs",
    "smoke:extraction": "corepack pnpm build && node test/package-extraction-smoke.mjs",
    "smoke:consumer-workflow": "corepack pnpm build && node test/package-consumer-workflow-smoke.mjs",
    "demo": "corepack pnpm build && node examples/customer-orders/run-demo.mjs",
    "demo:storage": "corepack pnpm build && node examples/customer-orders-storage/run-demo.mjs",
    "demo:profile": "corepack pnpm build && node examples/profile-kafka/run-demo.mjs",
    "demo:authoring": "corepack pnpm build && node examples/authoring-review/run-demo.mjs",
    "test": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
